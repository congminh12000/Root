{
  "name": "root-web-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fetch:sources": "node scripts/fetch-sources/index.ts",
    "audit:rules": "node scripts/audit-rule-coverage/index.ts",
    "typecheck": "tsc -p packages/game-data && tsc -p packages/game-engine && tsc -p packages/game-engine/test",
    "test": "npm test --workspaces --if-present",
    "snapshot:rules": "node scripts/snapshot-rules/index.ts",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "acorn": "8.14.0",
    "typescript": "5.8.3",
    "yaml": "2.6.1"
  }
}
